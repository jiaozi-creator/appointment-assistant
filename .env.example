# Only for local development. Do not commit real secrets.
PORT=3001
HOST=127.0.0.1
DB_PATH=./data/appointment.sqlite
INIT_OWNER_EMAIL=owner@example.com
INIT_OWNER_PASSWORD=replace-with-strong-password
INIT_PLATFORM_EMAIL=platform@example.com
INIT_PLATFORM_PASSWORD=replace-with-an-independent-very-strong-password
COOKIE_SECURE=0
# NODE_ENV=production requires COOKIE_SECURE=1 and explicit HTTPS origin.
# ALLOWED_ORIGIN=https://appointment.example.com
