# Only for local development. Do not commit real secrets.
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgres://appointment:appointment@127.0.0.1:5432/appointment
INIT_OWNER_EMAIL=owner@example.com
INIT_OWNER_PASSWORD=replace-with-strong-password
INIT_PLATFORM_EMAIL=platform@example.com
INIT_PLATFORM_PASSWORD=replace-with-an-independent-very-strong-password
COOKIE_SECURE=0
# NODE_ENV=production requires COOKIE_SECURE=1 and explicit HTTPS origin.
# ALLOWED_ORIGIN=https://appointment.example.com

# Email. Leave SMTP_HOST empty to record test deliveries in the notifications table.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=studio@example.com

# Aliyun SMS. All four values are required before real messages are sent.
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# Payment. Omit PAYMENT_PROVIDER or the WeChat keys to use the immediate test channel.
# PAYMENT_PROVIDER=wechat
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_CERT_SERIAL=
# WECHAT_PRIVATE_KEY=
# WECHAT_PRIVATE_KEY_PATH=
# WECHAT_NOTIFY_URL=https://appointment.example.com/api/payments/wechat/notify
